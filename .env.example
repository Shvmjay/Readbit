# Readbit configuration. Copy to .env and adjust. Never commit real credentials.
# Settings are validated at startup; production refuses unsafe defaults.

# --- Application
APP_ENV=development                 # development | test | production
APP_URL=http://localhost:3000       # public web URL (used in links, e.g. password reset)
API_URL=http://localhost:8000       # where the web app's proxy reaches the API
SECRET_KEY=change-me-to-a-random-64-char-string   # openssl rand -hex 32 ; required in production
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false           # true only when the API is reachable solely via the web proxy / load balancer

# --- Database (PostgreSQL + pgvector in dev/prod; SQLite works for quick local runs and tests)
DATABASE_URL=postgresql+psycopg://readbit:readbit-dev-only@localhost:5432/readbit
DB_POOL_SIZE=5

# --- Authentication (built-in, standards-based: argon2id + server-side sessions)
AUTH_PROVIDER=local
AUTH_ISSUER=readbit
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
SESSION_TTL_HOURS=336
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_DELIVERY=log                  # log (development only) | smtp | disabled
SMTP_HOST=                          # any provider: Postmark, SES, Resend, Mailgun, SendGrid...
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=                          # e.g. Readbit <no-reply@your-domain>
SMTP_STARTTLS=true                  # false + port 465 for implicit TLS

# --- Object storage
STORAGE_PROVIDER=local              # local | s3
STORAGE_LOCAL_PATH=./.data/storage
STORAGE_BUCKET=readbit-private
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=                   # e.g. http://localhost:9000 for MinIO; empty for AWS S3
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Background jobs
JOB_BACKEND=thread                  # inline (tests) | thread (local, no Redis) | celery (production)
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=2

# --- AI
DEFAULT_LLM_PROVIDER=extractive     # extractive (offline, no key) | anthropic
LLM_API_KEY=                        # server-side only; never exposed to the browser
SUMMARY_MODEL=claude-sonnet-5
QA_MODEL=claude-sonnet-5
QUIZ_MODEL=claude-sonnet-5
VALIDATION_MODEL=claude-sonnet-5
ESCALATION_MODEL=claude-opus-5      # used when output from the task model fails validation
TRANSLATION_MODEL=claude-sonnet-5
LLM_EFFORT=medium                   # low | medium | high
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=hashing-v1
EMBEDDING_DIMENSIONS=256
OCR_PROVIDER=none                   # none | tesseract
OCR_API_KEY=
MALWARE_SCANNER=none                # none | clamav (fails closed when clamd is unreachable)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Limits
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_PAGES=1500
MAX_PROCESSING_DURATION=900         # seconds
MAX_GENERATION_TOKENS=8000
GUEST_RETENTION_HOURS=24
USER_RATE_LIMIT=30                  # AI requests per actor per minute
UPLOAD_RATE_LIMIT=10                # uploads per actor per 10 minutes
AI_DAILY_BUDGET=25                  # USD per UTC day across the deployment
MAX_EXCERPT_CHARS=320
MAX_QUOTE_RATIO=0.35
LESSON_SIZE=5

# --- Observability
LOG_LEVEL=INFO
ERROR_TRACKING_DSN=
METRICS_ENABLED=true
